##############################
# Bitrix24 form for Feedback #
##############################
## For example: 35
NUXT_PUBLIC_B24_FORM_ID="0"

## For example: c9qk4k
NUXT_PUBLIC_B24_FORM_SECRET="insert_secret"

## For example: https://cdn-ru.bitrix24.com/b80599/crm/form/loader_34.js
NUXT_PUBLIC_B24_FORM_LOADER_SCRIPT="insert_loaderScript"

######################################################################
# Baked at BUILD time                                                #
# Every NUXT_PUBLIC_* value is frozen into the prerendered HTML, so   #
# setting these only in the container's runtime env leaves them EMPTY #
# in the served pages and the feature silently switches off.          #
######################################################################

## Public origin the app is served from, e.g. https://smart-links.example.com.
## Used for the landing's canonical/og:url. Must be an ABSOLUTE http(s) URL —
## anything else is ignored and the tags are omitted rather than pointing at a guess.
NUXT_PUBLIC_SITE_URL=""

## Bitrix24 Market listing code (e.g. shef.smartlink). Enables the "rate this app"
## popup, which opens /marketplace/detail/<code>/. Empty => popup disabled.
NUXT_PUBLIC_B24_MARKET_CODE=""

## Build commit sha — shown in the landing footer and by /api/health. Defaults to "dev".
NUXT_PUBLIC_COMMIT_SHA=""

##############################
# Server (runtime)           #
##############################

## Postgres (server-side rating state). Empty => the app runs without a DB and the
## rating routes stay inert ({show:false}). e.g. postgres://user:pass@host:5432/smartlinks
DATABASE_URL=""

## Set to 1 when this process is directly internet-facing with NO reverse proxy in front
## (the Bitrix24 Vibecode Black Hole target — see docs/DEPLOY_VIBECODE.md). It makes the app
## send the CSP / security headers and enforce the body cap a proxy would otherwise provide.
## MUST stay empty behind a proxy: two CSP headers intersect restrictively, and the per-IP
## limits would bucket every client under the shared proxy address.
APP_EDGE_SECURITY=""

## Set to 1 ONLY after live-verifying that the ingress in front is a trusted proxy which
## APPENDS the real client as the last X-Forwarded-For hop. Otherwise the header is
## client-controlled and rate limits key on the real TCP peer instead (the safe default).
APP_EDGE_TRUST_XFF=""

##############################
# Market OAuth (S4)          #
# Empty => the install/uninstall webhook answers 503 and the app works frame-only:
# the rating state keys on the verified host instead of member_id.
##############################

## Application credentials from the Bitrix24 Market listing (or a local app).
## Both are required for the install-time member_id binding and for the keep-alive
## refresh — without them neither is possible and install falls back to a domain-only check.
B24_CLIENT_ID=""
B24_CLIENT_SECRET=""

## AES-256-GCM key for the refresh_token at rest — 32 bytes, base64.
## Generate with: openssl rand -base64 32
## Required to store a refresh token at all: without it the install webhook returns 503
## rather than persisting the long-lived credential in plaintext.
B24_TOKEN_ENC_KEY=""

## Optional extra gate on a FIRST install only. Normally empty — Bitrix delivers the real
## application_token with the install event and the app remembers it per portal.
B24_APPLICATION_TOKEN=""

## How long an uninstall is remembered so a late/out-of-order install cannot resurrect the
## portal. Default 30, clamped to [1,365]. Days, not forever — see server/db/schema.ts.
TOMBSTONE_TTL_DAYS=""

## Extra Bitrix24 cloud zones for the SSRF allowlist, comma-separated (e.g. "bitrix24.xx").
## Escape hatch so a zone missing from server/utils/b24Rest.ts B24_ZONES is a config change
## rather than an outage. Leave empty unless a real portal is being rejected.
B24_EXTRA_ZONES=""

##############################
# Offline tooling / dev      #
##############################

## Offline only: used by `pnpm translate-ui` (tools/translate.ui.ts). Not bundled into the app.
DEEPSEEK_API_KEY='sk-xxxxxxxxx'

## Live Bitrix24 test portal webhook, used for manual REST checks. Keep it OUT of the repo:
## put the real value in .env.b24test (gitignored), never here.
B24_HOOK=""

## Allow overriding allowed hosts via env, e.g., NUXT_ALLOWED_HOSTS="example.com,foo.com"
NUXT_ALLOWED_HOSTS="example.com,foo.com"
