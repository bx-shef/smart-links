{
  "name": "smart-link",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "generate-archive-for-b24": "pnpm run generate && pnpm run tools:fix-paths && pnpm run tools:create-archive",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "nuxt prepare && vue-tsc --noEmit -p .nuxt/tsconfig.json && vue-tsc --noEmit -p .nuxt/tsconfig.server.json",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "translate-ui": "tsx tools/translate.ui.ts",
    "tools:fix-paths": "node ./tools/fix-paths.mjs",
    "tools:create-archive": "node ./tools/create-archive.mjs"
  },
  "dependencies": {
    "@bitrix24/b24icons-vue": "^2.0.2",
    "@bitrix24/b24jssdk": "^0.4.9",
    "@bitrix24/b24ui-nuxt": "^1.0.3",
    "@nuxtjs/i18n": "^10.0.6",
    "@pinia/nuxt": "^0.11.2",
    "@tailwindcss/vite": "^4.1.13",
    "nuxt": "^4.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.20.0",
    "archiver": "^7.0.1",
    "consola": "^3.4.2",
    "eslint": "^9.34.0",
    "glob": "^10.4.5",
    "openai": "^5.16.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
